rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'] ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
        'uid', 'name', 'username', 'email', 'profileImage', 'photoUrl', 
        'xp', 'level', 'streak', 'leafBalance', 'isPremium', 'darkMode', 
        'notificationsEnabled', 'createdAt', 'lastActive', 'role'
      ]) &&
      request.resource.data.username is string &&
      request.resource.data.xp is int;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'uid', 'lessonId', 'score', 'completed', 'completedAt'
      ]) &&
      request.resource.data.score is int &&
      request.resource.data.completed is bool;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserProfile();
      allow update: if isOwner(userId) && validUserProfile() && 
        // Prevent normal users from self-promoting to admin role
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium']) || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId}/progress/{lessonId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validProgress();
      allow delete: if isAdmin();
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/quests/{questId} {
      allow read, write: if isOwner(userId);
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId}/units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId}/units/{unitId}/lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaderboards/{boardId}/entries/{entryUserId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /creatorCourses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
